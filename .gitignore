# ===== Node =====
node_modules/
npm-debug.log*
yarn-error.log*

# ===== Build output =====
# .zab is the Zepp App Store bundle; dist/ holds cover/screen images for the listing.
dist/
build/
*.zab
coverage/

# Zeus CLI cache and downloaded device targets
.zeus/
.download/

# ===== Environment variables =====
.env
.env.*

# ===== Logs =====
*.log
logs/

# ===== IDEs =====
.vscode/
.zed/
.idea/
*.iml

# ===== AI agents =====
# .claude/ itself is committed: it carries the project's own instructions, skills
# and hooks, which are as much a part of the repository as the lint config. Only
# the per-machine parts stay out - settings.local.json holds one developer's
# permission grants, and the rest is scratch the agent writes as it works.
.claude/settings.local.json
.claude/*.local.json
.claude/projects/
.claude/shell-snapshots/
.claude/statsig/
.claude/todos/
.cursor/
.windsurf/
.gemini/
.aider*
.continue/

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Temporary files (never committed, holds working context) =====
tmp/
temp/
